# Copy to .env and fill in. Never commit .env.
POSTGRES_DB=pricecompare
POSTGRES_USER=pricecompare
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_PORT=5432
BACKEND_PORT=8080
# Required by the admin API/UI (X-Admin-Token header)
ADMIN_TOKEN=change-me-to-another-long-random-string
# 0 = full catalog; e.g. 100 for development
CRAWLER_MAX_PRODUCTS=0
# e.g. "0 0 5 * * *" = crawl all stores daily at 05:00 Yerevan time; empty = disabled
CRAWLER_SCHEDULE_CRON=
# Price-drop push notifications through Expo (true/false); EXPO_ACCESS_TOKEN only if enhanced push security is on
PUSH_ENABLED=true
EXPO_ACCESS_TOKEN=
# Crawl alerts (optional): Telegram bot (@BotFather token + chat id) and/or a Slack/Discord webhook URL
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=
# alert when a store has had no successful crawl for this long (only with CRAWLER_SCHEDULE_CRON)
ALERT_STALE_HOURS=36
# Production (docker-compose.prod.yml, see docs/deployment.md)
DOMAIN=
ACME_EMAIL=
# public API requests per minute per client IP; 0 = off
RATE_LIMIT_PER_MINUTE=240
BACKUP_KEEP_DAYS=14
# UTC hour of the daily database backup (1 = 05:00 Yerevan)
BACKUP_HOUR=1
CORS_ALLOWED_ORIGINS=http://localhost:5173
